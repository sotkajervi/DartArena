{
  "name": "dartarena",
  "private": true,
  "version": "0.0.0",
  "description": "DartArena online darts",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build:password-reset": "node scripts/build-password-reset.cjs",
    "test:password-reset": "node --test tests/password-reset.test.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,md}\" \"*.md\" \"*.json\" \"*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,md}\" \"*.md\" \"*.json\" \"*.mjs\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:audio && npm run test:invites && npm run test:lobby && npm run test:navigation && npm run test:rooms && npm run test:tournament-lobby && npm run test:group-redirect && npm run test:autozoom && npm run test:zoom-cam && npm run test:password-reset && npm run test:fx && npm run test:zoom-tip && npm run test:online-heatmap && npm run test:d1-live && npm run test:spectator && npm run test:tournament-stats && npm run test:group-results",
    "test:audio": "node --test tests/remote-audio-autounlock.test.cjs",
    "test:invites": "node --test tests/challenge-outgoing.test.cjs",
    "test:lobby": "node --test tests/lobby-shortcuts.test.cjs",
    "test:navigation": "node --test tests/same-tab-match-navigation.test.cjs",
    "test:rooms": "node --test tests/lobby-tab-rooms.test.cjs",
    "test:tournament-lobby": "node --test tests/tournament-lobby-navigation.test.cjs",
    "test:group-redirect": "node --test tests/tournament-ready-lobby.test.cjs",
    "test:autozoom": "node --test autozoom/tracker.test.cjs",
    "test:match-autozoom": "node --test autozoom/match-beta.test.cjs",
    "test:match-autozoom-share": "node --test autozoom/match-share.test.cjs",
    "test:zoom-cam": "node --test autozoom/zoom-cam.test.cjs",
    "test:fx": "node --test tests/fx-live.test.cjs tests/fx-match-bridge.test.cjs",
    "test:zoom-tip": "node --test autozoom/tip-map.test.cjs autozoom/tip-bias.test.cjs autoscoring/tip-online-calibration.test.cjs",
    "test:online-heatmap": "node --test tests/online-heatmap-beta.test.cjs",
    "test:d1-live": "node --test tests/d1-live-testzone.test.cjs",
    "test:spectator": "node --test tests/spectator-fx.test.cjs",
    "test:tournament-stats": "node --test tests/tournament-stats-fetch.test.cjs",
    "test:group-results": "node --test tests/tournament-group-results-layout.test.cjs"
  },
  "devDependencies": {
    "eslint": "10.10.0",
    "prettier": "3.9.9",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.0"
  }
}
