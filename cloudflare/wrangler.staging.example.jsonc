// Example staging configuration ONLY. Do not deploy against production credentials.
// Copy to wrangler.jsonc locally and supply the public Supabase URL/key in the
// Cloudflare dashboard or staging environment. Never commit actual bearer secrets.
{
  "name": "dartarena-realtime-security-staging",
  "main": "dartarena-realtime.staging.js",
  "compatibility_date": "2026-10-28",
  "durable_objects": {
    "bindings": [{ "name": "SFU_ROOMS", "class_name": "SfuRoom" }]
  },
  "migrations": [
    { "tag": "sfu-security-v1", "new_sqlite_classes": ["SfuRoom"] }
  ]
}
